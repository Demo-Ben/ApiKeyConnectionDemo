@page "/apitest"
@rendermode InteractiveServer

@using BlazorClientDemo.Services
@using ApiKey.Shared;

@inject ApiTestClient _client

<h3>API Test</h3>

<button class="btn btn-primary" @onclick="CallApi">Ping API</button>

@if (Result != null)
{
    <pre>@Result</pre>
}

@code {
    private PingResponseDto Result;

    private async Task CallApi()
    {
        Result = await _client.PingAsync();
    }
}
