@page "/ApiTest"
@rendermode InteractiveServer

@using BlazorClientDemo.Services
@using ApiKey.Shared;

@inject ApiTestClient _client

<h3>API Key Test</h3>

<button class="btn btn-primary" @onclick="CallApi">Verify API Key</button>

@if (Result != null)
{
    <pre>@Result</pre>
}

@code {
    private PingResponseDto Result;

    private async Task CallApi()
    {
        Result = await _client.PingAsync();
    }
}
